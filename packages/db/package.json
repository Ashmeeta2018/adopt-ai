{
  "name": "@adopt-ai/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed for Adopt AI.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "node --env-file=.env --import tsx src/seed.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@adopt-ai/config-eslint": "workspace:*",
    "@adopt-ai/config-tsconfig": "workspace:*",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
