# ============================================================
# Adopt AI — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Email provider (Resend recommended)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=hello@adoptai.com

# Okta OIDC (enterprise SSO)
AUTH_OKTA_ID=
AUTH_OKTA_SECRET=
AUTH_OKTA_ISSUER=

# --- Database ---
# Postgres connection string (Neon, Supabase, or local Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/adopt_ai
# Direct (non-pooled) connection — used by Prisma migrations
DIRECT_URL=postgresql://user:password@localhost:5432/adopt_ai

# --- Rate limiting (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduling (Cal.com) ---
# Your Cal.com booking path. Format: <username>/<event-type-slug>
# Example: NEXT_PUBLIC_CAL_LINK=adoptai/30min
# Sign up at cal.com, create a "30 min" event type, then set this.
NEXT_PUBLIC_CAL_LINK=

# --- AI / Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6-20250514
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0

# --- Observability ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Mobile (Expo) ---
# These are public — they ship in the binary. Never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_SENTRY_DSN=
